@@ -30,7 +30,10 @@ static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
         r = s->strap_mode;
         break;
 
+    case 0x3c: r = s->regs[0x04 / 4]; break;
+    case 0x40: r = s->regs[0x10 / 4]; break;
     default:
+        r = s->regs[addr / 4];
         break;
     }
     return r;
@@ -39,6 +42,25 @@ static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    switch (addr) {
+    case 0x08: s->regs[0x04 / 4] |= value; break;
+    case 0x0c: s->regs[0x04 / 4] &= ~value; break;
+    case 0x14: s->regs[0x10 / 4] |= value; break;
+    case 0x18: s->regs[0x10 / 4] &= ~value; break;
+    case 0x24: s->regs[0x20 / 4] |= value; break;
+    case 0x28: s->regs[0x20 / 4] &= ~value; break;
+    case 0x30: s->regs[0x2c / 4] |= value; break;
+    case 0x34: s->regs[0x2c / 4] &= ~value; break;
+    default: s->regs[addr / 4] = value; break;
+    }
+    /* Output-latch bring-up only: GPIO matrix/input/pulls/edge IRQs are future work. */
+    if (addr <= 0x34) {
+        for (unsigned pin = 0; pin < 49; pin++) {
+            uint32_t output = s->regs[(pin < 32 ? 0x04 : 0x10) / 4];
+            qemu_set_irq(s->pins[pin], (output >> (pin % 32)) & 1);
+        }
+    }
 }
 
