diff --git a/hw/display/esp32s3_stick_lcd.c b/hw/display/esp32s3_stick_lcd.c
new file mode 100644
index 0000000..1782c07
--- /dev/null
+++ b/hw/display/esp32s3_stick_lcd.c
@@ -0,0 +1,293 @@
+/*
+ * StickS3 bring-up: ESP32-S3 GPSPI3 PIO and ST7789 logical controller RAM.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * No DMA/bit-level PHY/gamma/scanout/migration fidelity is claimed.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/display/esp32s3_stick_lcd.h"
+
+#define SPI_CMD 0x00
+#define SPI_CLOCK 0x0c
+#define SPI_USER 0x10
+#define SPI_USER1 0x14
+#define SPI_USER2 0x18
+#define SPI_DLEN 0x1c
+#define SPI_MISC 0x20
+#define SPI_DMA_CONF 0x30
+#define SPI_INT_ENA 0x34
+#define SPI_INT_CLR 0x38
+#define SPI_INT_RAW 0x3c
+#define SPI_INT_ST 0x40
+#define SPI_INT_SET 0x44
+#define SPI_W0 0x98
+#define SPI_USR BIT(24)
+#define SPI_UPDATE BIT(23)
+#define TRANS_DONE BIT(12)
+#define TRANS_ERROR BIT(1)
+
+static void stick_irq(Esp32S3StickLCDState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[SPI_INT_RAW / 4] & s->regs[SPI_INT_ENA / 4]));
+}
+
+static void panel_reset(Esp32S3StickLCDState *s)
+{
+    memset(s->ram, 0, sizeof(s->ram));
+    s->x0 = s->y0 = s->x = s->y = 0;
+    s->x1 = 239;
+    s->y1 = 319;
+    s->command = s->argc = s->madctl = 0;
+    s->colmod = 0x66;
+    s->sleep = true;
+    s->display_on = s->have_hi = false;
+    s->dirty = true;
+}
+
+static void panel_byte(Esp32S3StickLCDState *s, bool dc, uint8_t value)
+{
+    if (!s->reset_high) {
+        return;
+    }
+    if (!dc) {
+        s->command = value;
+        s->argc = 0;
+        s->have_hi = false;
+        switch (value) {
+        case 0x01: panel_reset(s); break;
+        case 0x10: s->sleep = true; break;
+        case 0x11: s->sleep = false; break;
+        case 0x28: s->display_on = false; break;
+        case 0x29: s->display_on = true; break;
+        case 0x2c: s->x = s->x0; s->y = s->y0; break;
+        default: break; /* power/gamma/inversion setup: not optical simulation */
+        }
+        s->dirty = true;
+        return;
+    }
+    if (s->command == 0x2c || s->command == 0x3c) {
+        unsigned x = s->x, y = s->y;
+        if (s->colmod != 0x55) {
+            qemu_log_mask(LOG_GUEST_ERROR, "stick-lcd: only RGB565 RAMWR is supported\n");
+            return;
+        }
+        if (!s->have_hi) {
+            s->pixel_hi = value;
+            s->have_hi = true;
+            return;
+        }
+        s->have_hi = false;
+        if (s->madctl & 0x20) {
+            unsigned tmp = x; x = y; y = tmp;
+        }
+        if (s->madctl & 0x40) { x = 239 - x; }
+        if (s->madctl & 0x80) { y = 319 - y; }
+        if (x < 240 && y < 320 && s->x0 <= s->x1 && s->y0 <= s->y1) {
+            uint16_t pixel = (s->pixel_hi << 8) | value;
+            if (s->madctl & 8) { /* BGR storage order */
+                pixel = ((pixel & 31) << 11) | (pixel & 0x7e0) | (pixel >> 11);
+            }
+            s->ram[y * 240 + x] = pixel;
+            s->dirty = true;
+        }
+        if (++s->x > s->x1) {
+            s->x = s->x0;
+            if (++s->y > s->y1) { s->y = s->y0; }
+        }
+        return;
+    }
+    if (s->argc < sizeof(s->args)) {
+        s->args[s->argc++] = value;
+    }
+    if ((s->command == 0x2a || s->command == 0x2b) && s->argc == 4) {
+        uint16_t start = (s->args[0] << 8) | s->args[1];
+        uint16_t end = (s->args[2] << 8) | s->args[3];
+        if (s->command == 0x2a) { s->x0 = start; s->x1 = end; }
+        else { s->y0 = start; s->y1 = end; }
+    } else if (s->command == 0x36 && s->argc == 1) {
+        s->madctl = value;
+        s->dirty = true;
+    } else if (s->command == 0x3a && s->argc == 1) {
+        s->colmod = value;
+    }
+}
+
+static void stick_update(void *opaque)
+{
+    Esp32S3StickLCDState *s = opaque;
+    unsigned w = (s->madctl & 0x20) ? 240 : 135;
+    unsigned h = (s->madctl & 0x20) ? 135 : 240;
+    DisplaySurface *surface;
+    if (!s->dirty) { return; }
+    qemu_console_resize(s->con, w, h);
+    surface = qemu_console_surface(s->con);
+    for (unsigned y = 0; y < h; y++) {
+        uint32_t *row = (uint32_t *)(surface_data(surface) + y * surface_stride(surface));
+        for (unsigned x = 0; x < w; x++) {
+            unsigned px = (s->madctl & 0x20) ? 52 + y : 52 + x;
+            unsigned py = (s->madctl & 0x20) ? 40 + x : 40 + y;
+            uint16_t c = (!s->sleep && s->display_on) ? s->ram[py * 240 + px] : 0;
+            row[x] = 0xff000000 | (((c >> 11) * 255 / 31) << 16) |
+                     ((((c >> 5) & 63) * 255 / 63) << 8) | ((c & 31) * 255 / 31);
+        }
+    }
+    dpy_gfx_update(s->con, 0, 0, w, h);
+    s->dirty = false;
+}
+
+static void stick_invalidate(void *opaque)
+{
+    Esp32S3StickLCDState *s = opaque;
+    s->dirty = true;
+}
+
+static const GraphicHwOps stick_graphics = {
+    .gfx_update = stick_update,
+    .invalidate = stick_invalidate,
+};
+
+static void stick_complete(void *opaque)
+{
+    Esp32S3StickLCDState *s = opaque;
+    if (s->pending_selected) {
+        for (unsigned i = 0; i < s->pending_len; i++) {
+            panel_byte(s, s->pending_dc, s->pending[i]);
+        }
+    }
+    s->regs[SPI_CMD / 4] &= ~SPI_USR;
+    s->regs[SPI_INT_RAW / 4] |= TRANS_DONE;
+    stick_irq(s);
+}
+
+static bool append_value(Esp32S3StickLCDState *s, uint32_t value, unsigned bits)
+{
+    if ((bits & 7) || bits > 32) { return false; }
+    for (unsigned n = bits / 8; n; n--) {
+        s->pending[s->pending_len++] = value >> ((n - 1) * 8);
+    }
+    return true;
+}
+
+static void stick_start(Esp32S3StickLCDState *s)
+{
+    uint32_t user = s->regs[SPI_USER / 4];
+    unsigned data_bits = (user & BIT(27)) ? (s->regs[SPI_DLEN / 4] & 0x3ffff) + 1 : 0;
+    unsigned command_bits = (user & BIT(31)) ? (s->regs[SPI_USER2 / 4] >> 28) + 1 : 0;
+    unsigned address_bits = (user & BIT(30)) ? (s->regs[SPI_USER1 / 4] >> 27) + 1 : 0;
+    unsigned dummy_bits = (user & BIT(29)) ? (s->regs[SPI_USER1 / 4] & 0xff) + 1 : 0;
+    uint32_t divider = s->regs[SPI_CLOCK / 4];
+    uint64_t cycles = (divider & BIT(31)) ? 1 :
+        (((divider >> 18) & 15) + 1) * (((divider >> 12) & 63) + 1);
+    s->pending_len = 0;
+    /* Reject unsupported modes visibly rather than pretending DMA/readback worked. */
+    if ((s->regs[SPI_DMA_CONF / 4] & (BIT(28) | BIT(27))) ||
+        (user & BIT(28)) || data_bits > 512 || (data_bits & 7) ||
+        (s->regs[0x08 / 4] & ((3u << 25) | 0x1ff60)) ||
+        !append_value(s, s->regs[SPI_USER2 / 4] & 0xffff, command_bits) ||
+        !append_value(s, s->regs[0x04 / 4], address_bits)) {
+        qemu_log_mask(LOG_UNIMP, "stick-lcd: unsupported SPI3 DMA/read/bit-order/length\n");
+        s->regs[SPI_CMD / 4] &= ~SPI_USR;
+        s->regs[SPI_INT_RAW / 4] |= TRANS_ERROR;
+        stick_irq(s);
+        return;
+    }
+    for (unsigned i = 0; i < data_bits / 8; i++) {
+        s->pending[s->pending_len++] = s->regs[SPI_W0 / 4 + i / 4] >> ((i % 4) * 8);
+    }
+    s->pending_dc = s->dc;
+    s->pending_selected = !(s->regs[SPI_MISC / 4] & 1) || !s->manual_cs;
+    s->regs[SPI_CMD / 4] = SPI_USR;
+    s->regs[SPI_INT_RAW / 4] &= ~TRANS_DONE;
+    /* 80MHz APB-clock assumption; SPI divider is guest-programmed. */
+    uint64_t ns = ((uint64_t)(data_bits + command_bits + address_bits + dummy_bits) * cycles * 1000000000 + 79999999) / 80000000;
+    timer_mod(s->done_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + MAX(ns, 1));
+    stick_irq(s);
+}
+
+static uint64_t stick_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32S3StickLCDState *s = opaque;
+    if (addr == SPI_INT_ST) { return s->regs[SPI_INT_RAW / 4] & s->regs[SPI_INT_ENA / 4]; }
+    return s->regs[addr / 4];
+}
+
+static void stick_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    Esp32S3StickLCDState *s = opaque;
+    if (addr == SPI_CMD) {
+        if ((value & SPI_USR) && !(s->regs[SPI_CMD / 4] & SPI_USR)) { stick_start(s); }
+        return; /* SPI_UPDATE crosses the clock domain immediately in this model */
+    }
+    if (addr == SPI_INT_CLR) { s->regs[SPI_INT_RAW / 4] &= ~value; }
+    else if (addr == SPI_INT_SET) { s->regs[SPI_INT_RAW / 4] |= value; }
+    else if (addr != SPI_INT_ST) { s->regs[addr / 4] = value; }
+    stick_irq(s);
+}
+
+static const MemoryRegionOps stick_ops = {
+    .read = stick_read, .write = stick_write, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4, .valid.max_access_size = 4,
+};
+
+static void stick_pin(void *opaque, int pin, int level)
+{
+    Esp32S3StickLCDState *s = opaque;
+    if (pin == 0) { s->dc = level; }
+    else if (pin == 1) {
+        if (!level && s->reset_high) { panel_reset(s); }
+        s->reset_high = level;
+    } else { s->manual_cs = level; }
+}
+
+static void stick_reset(Object *obj, ResetType type)
+{
+    Esp32S3StickLCDState *s = ESP32S3_STICK_LCD(obj);
+    timer_del(s->done_timer);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[SPI_CLOCK / 4] = (3 << 12) | (1 << 6) | 3;
+    s->reset_high = s->manual_cs = true;
+    s->dc = false;
+    panel_reset(s);
+}
+
+static void stick_realize(DeviceState *dev, Error **errp)
+{
+    Esp32S3StickLCDState *s = ESP32S3_STICK_LCD(dev);
+    s->con = graphic_console_init(dev, 0, &stick_graphics, s);
+    qemu_console_resize(s->con, 135, 240);
+}
+
+static void stick_init(Object *obj)
+{
+    Esp32S3StickLCDState *s = ESP32S3_STICK_LCD(obj);
+    memory_region_init_io(&s->iomem, obj, &stick_ops, s, TYPE_ESP32S3_STICK_LCD, 0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    qdev_init_gpio_in(DEVICE(obj), stick_pin, 3);
+    s->done_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, stick_complete, s);
+    stick_reset(obj, RESET_TYPE_COLD);
+}
+
+static void stick_finalize(Object *obj)
+{
+    timer_free(ESP32S3_STICK_LCD(obj)->done_timer);
+}
+
+static void stick_class(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = stick_realize;
+    dc->user_creatable = false;
+    RESETTABLE_CLASS(klass)->phases.hold = stick_reset;
+}
+
+static const TypeInfo stick_info = {
+    .name = TYPE_ESP32S3_STICK_LCD, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32S3StickLCDState), .instance_init = stick_init,
+    .instance_finalize = stick_finalize, .class_init = stick_class,
+};
+
+static void stick_register(void) { type_register_static(&stick_info); }
+type_init(stick_register)
diff --git a/include/hw/display/esp32s3_stick_lcd.h b/include/hw/display/esp32s3_stick_lcd.h
new file mode 100644
index 0000000..51f72ef
--- /dev/null
+++ b/include/hw/display/esp32s3_stick_lcd.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "hw/sysbus.h"
+#include "ui/console.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESP32S3_STICK_LCD "esp32s3.stick-spi-lcd"
+#define ESP32S3_STICK_LCD(obj) OBJECT_CHECK(Esp32S3StickLCDState, (obj), TYPE_ESP32S3_STICK_LCD)
+
+typedef struct Esp32S3StickLCDState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QemuConsole *con;
+    QEMUTimer *done_timer;
+    uint32_t regs[64];
+    uint8_t pending[72]; /* optional command/address plus 64-byte PIO FIFO */
+    unsigned pending_len;
+    bool pending_dc, pending_selected;
+    bool dc, reset_high, manual_cs;
+    uint16_t ram[240 * 320];
+    uint16_t x0, x1, y0, y1, x, y;
+    uint8_t command, args[16], argc, madctl, colmod, pixel_hi;
+    bool sleep, display_on, have_hi, dirty;
+} Esp32S3StickLCDState;
